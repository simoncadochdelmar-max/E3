<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Espace Artisans - Entreprise 3</title>
    <!-- Tailwind CSS pour un design moderne et pro -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Supabase JS Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <!-- FontAwesome pour les icônes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen pb-20">

    <!-- HEADER / NAVIGATION -->
    <header class="bg-indigo-900 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-md mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <div class="bg-indigo-600 p-2 rounded-lg text-white font-bold">
                    <i class="fa-solid fa-helmet-safety"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight">ENTREPRISE 3</h1>
                    <p class="text-xs text-indigo-300">Réseau Artisans & Syndics</p>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <button onclick="chargerInterventions()" class="bg-indigo-800 hover:bg-indigo-700 p-2 rounded-full text-xs transition" title="Actualiser">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
                <div class="w-8 h-8 rounded-full bg-indigo-700 flex items-center justify-center font-bold text-sm border border-indigo-500">
                    A
                </div>
            </div>
        </div>
    </header>

    <!-- CONTENU PRINCIPAL -->
    <main class="max-w-md mx-auto px-4 mt-4">

        <!-- STATUT DISPONIBILITÉ -->
        <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 mb-4 flex justify-between items-center">
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Mon statut</span>
                <h2 class="font-bold text-emerald-600 flex items-center gap-2 mt-0.5">
                    <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span> Prêt à intervenir
                </h2>
            </div>
            <span class="text-xs bg-slate-100 text-slate-600 px-3 py-1.5 rounded-full font-medium">Île-de-France</span>
        </div>

        <!-- FILTRES RAPIDES -->
        <div class="flex gap-2 overflow-x-auto pb-2 mb-4 scrollbar-none">
            <button onclick="filtrer('tous')" class="px-4 py-2 bg-indigo-900 text-white text-xs font-medium rounded-full whitespace-nowrap shadow-sm">Toutes les offres</button>
            <button onclick="filtrer('Urgent')" class="px-4 py-2 bg-white text-slate-600 border border-slate-200 text-xs font-medium rounded-full whitespace-nowrap hover:bg-slate-50">Urgences</button>
            <button onclick="filtrer('Plomberie')" class="px-4 py-2 bg-white text-slate-600 border border-slate-200 text-xs font-medium rounded-full whitespace-nowrap hover:bg-slate-50">Plomberie</button>
            <button onclick="filtrer('Serrurerie')" class="px-4 py-2 bg-white text-slate-600 border border-slate-200 text-xs font-medium rounded-full whitespace-nowrap hover:bg-slate-50">Serrurerie</button>
        </div>

        <!-- LISTE DES DEMANDES (Générée dynamiquement depuis Supabase) -->
        <div id="liste-interventions" class="space-y-4">
            <!-- Indicateur de chargement initial -->
            <div class="text-center py-12 text-slate-400">
                <i class="fa-solid fa-spinner fa-spin text-2xl mb-2 text-indigo-600"></i>
                <p class="text-sm">Connexion à la base de données...</p>
            </div>
        </div>

    </main>

    <!-- NAVIGATION BASSE (MOBILE STYLE) -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 shadow-lg py-2 z-50">
        <div class="max-w-md mx-auto flex justify-around text-slate-500 text-xs font-medium">
            <a href="#" class="flex flex-col items-center text-indigo-600">
                <i class="fa-solid fa-map-location-dot text-lg mb-1"></i>
                <span>Chantiers</span>
            </a>
            <a href="#" class="flex flex-col items-center hover:text-indigo-600">
                <i class="fa-solid fa-clock-rotate-left text-lg mb-1"></i>
                <span>Historique</span>
            </a>
            <a href="#" class="flex flex-col items-center hover:text-indigo-600">
                <i class="fa-solid fa-wallet text-lg mb-1"></i>
                <span>Gains</span>
            </a>
            <a href="#" class="flex flex-col items-center hover:text-indigo-600">
                <i class="fa-solid fa-gear text-lg mb-1"></i>
                <span>Profil</span>
            </a>
        </div>
    </nav>

    <!-- SCRIPT DE CONNEXION SUPABASE -->
    <script>
        // 1. Initialisation de Supabase avec tes identifiants
        const supabaseUrl = 'https://yqjeqcomrubelahrvizd.supabase.co';
        const supabaseKey = 'sb_publishable_hKaiVb_fWBPRgESxpwWNCA_iAN9acMe';
        const _supabase = supabase.createClient(supabaseUrl, supabaseKey);

        let toutesLesInterventions = [];

        // 2. Fonction pour charger les données depuis la table 'interventions'
        async function chargerInterventions() {
            const container = document.getElementById('liste-interventions');
            container.innerHTML = `
                <div class="text-center py-12 text-slate-400">
                    <i class="fa-solid fa-spinner fa-spin text-2xl mb-2 text-indigo-600"></i>
                    <p class="text-sm">Actualisation des chantiers...</p>
                </div>
            `;

            try {
                const { data, error } = await _supabase
                    .from('interventions')
                    .select('*')
                    .order('created_at', { ascending: false });

                if (error) {
                    throw error;
                }

                toutesLesInterventions = data || [];
                afficherInterventions(toutesLesInterventions);

            } catch (err) {
                console.error("Erreur Supabase :", err);
                container.innerHTML = `
                    <div class="bg-amber-50 border border-amber-200 text-amber-800 p-4 rounded-xl text-center">
                        <i class="fa-solid fa-triangle-exclamation text-xl mb-1 text-amber-600"></i>
                        <p class="text-sm font-semibold">Aucune donnée ou table vide</p>
                        <p class="text-xs text-amber-600 mt-1">Vérifie que tu as bien créé la table <b>interventions</b> dans ton dashboard Supabase.</p>
                        <button onclick="chargerInterventions()" class="mt-3 bg-amber-600 text-white text-xs px-4 py-2 rounded-lg font-medium hover:bg-amber-700">Réessayer</button>
                    </div>
                `;
            }
        }

        // 3. Affichage des cartes dynamiques
        function afficherInterventions(data) {
            const container = document.getElementById('liste-interventions');
            
            if (data.length === 0) {
                container.innerHTML = `
                    <div class="bg-white border border-slate-100 p-8 rounded-xl text-center shadow-sm">
                        <i class="fa-solid fa-folder-open text-3xl text-slate-300 mb-2"></i>
                        <p class="text-sm font-semibold text-slate-600">Aucun chantier disponible pour le moment</p>
                        <p class="text-xs text-slate-400 mt-1">Les nouvelles demandes issues des QR codes syndics apparaîtront ici en direct.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = data.map(item => `
                <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-100 hover:shadow-md transition">
                    <div class="flex justify-between items-start mb-2">
                        <span class="text-xs font-bold px-2.5 py-1 rounded-md ${item.urgence === 'Urgent' ? 'bg-rose-100 text-rose-700' : 'bg-indigo-50 text-indigo-700'}">
                            ${item.type_travaux || 'Intervention'} • ${item.urgence || 'Normal'}
                        </span>
                        <span class="text-xs text-slate-400">${new Date(item.created_at).toLocaleDateString()}</span>
                    </div>
                    
                    <h3 class="font-bold text-slate-900 text-sm mb-1 flex items-center gap-1.5">
                        <i class="fa-solid fa-location-dot text-indigo-600"></i> ${item.adresse || 'Adresse non spécifiée'}
                    </h3>
                    
                    <p class="text-xs text-slate-600 mb-3 bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                        ${item.description || 'Pas de description particulière.'}
                    </p>

                    ${item.photo_url ? `<img src="${item.photo_url}" class="w-full h-32 object-cover rounded-lg mb-3 border border-slate-100" alt="Photo incident">` : ''}

                    <div class="flex gap-2">
                        <button onclick="accepterMission(${item.id})" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold py-2.5 px-4 rounded-lg transition shadow-sm flex items-center justify-center gap-2">
                            <i class="fa-solid fa-check"></i> Accepter la mission
                        </button>
                        <a href="https://maps.google.com/?q=${encodeURIComponent(item.adresse || '')}" target="_blank" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-2.5 rounded-lg text-xs font-semibold flex items-center justify-center transition">
                            <i class="fa-solid fa-diamond-turn-right"></i>
                        </a>
                    </div>
                </div>
            `).join('');
        }

        // 4. Action pour accepter un chantier
        async function accepterMission(id) {
            try {
                const { error } = await _supabase
                    .from('interventions')
                    .update({ statut: 'accepte' })
                    .eq('id', id);

                if (error) throw error;
                
                alert("Mission acceptée avec succès ! Les détails de contact du syndic/particulier vous ont été attribués.");
                chargerInterventions();
            } catch (err) {
                alert("Erreur lors de l'acceptation : " + err.message);
            }
        }

        // 5. Filtres par catégorie
        function filtrer(critere) {
            if (critere === 'tous') {
                afficherInterventions(toutesLesInterventions);
            } else if (critere === 'Urgent') {
                afficherInterventions(toutesLesInterventions.filter(i => i.urgence === 'Urgent'));
            } else {
                afficherInterventions(toutesLesInterventions.filter(i => i.type_travaux === critere));
            }
        }

        // Lancement au chargement de la page
        chargerInterventions();
    </script>
</body>
</html>